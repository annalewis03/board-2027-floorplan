const json = (body, status = 200) =>
  new Response(JSON.stringify(body), {
    status,
    headers: { "content-type": "application/json", "cache-control": "no-store" },
  });
const fail = (status, code, message) => json({ code, message }, status);

const same = (a, b) => {
  const h = (v) => createHash("sha256").update(v).digest();
  return timingSafeEqual(h(a), h(b));
};

function isEditor(req) {
  const want = process.env.EDIT_PASSWORD || "";
  const got = req.headers.get("x-edit-password") || "";
  return !!want && !!got && same(want, got);
}

// Second lock behind the site-wide one in netlify/edge-functions/lock.js: reading bookings also
// needs the view or edit password, so the data stays private even if that outer lock is removed.
function isViewer(req) {
  if (isEditor(req)) return true;
  const view = process.env.VIEW_PASSWORD || "", edit = process.env.EDIT_PASSWORD || "";
  const h = req.headers.get("authorization") || "";
  if (!view || !h.toLowerCase().startsWith("basic ")) return false;
  let given = "";
  try {
    const text = Buffer.from(h.slice(6).trim(), "base64").toString("utf8");
    const i = text.indexOf(":");
    given = i < 0 ? "" : text.slice(i + 1);
  } catch { return false; }
  return !!given && (same(given, view) || (!!edit && same(given, edit)));
}

async function readAll(store) {
  const res = await store.getWithMetadata(BLOB, { type: "json", consistency: "strong" });
  if (!res || res.data == null) return { stands: INITIAL, etag: null };
  return { stands: res.data, etag: res.etag || null };
}

// read-modify-write with a retry, so two people saving different stands at once don't lose either change
async function mutate(store, change) {
  for (let attempt = 0; attempt < 6; attempt++) {
    const { stands, etag } = await readAll(store);
    const next = { ...stands };
    change(next);
    const res = await store.setJSON(BLOB, next, etag ? { onlyIfMatch: etag } : { onlyIfNew: true });
    if (!res || res.modified !== false) return next;
  }
  throw new Error("busy");
}

async function design(prompt) {
  const key = process.env.ANTHROPIC_API_KEY;
  if (!key) return fail(503, "not_configured", "ANTHROPIC_API_KEY is not set");
  const r = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "content-type": "application/json", "x-api-key": key, "anthropic-version": "2023-06-01" },
    body: JSON.stringify({
      model: process.env.CLAUDE_MODEL || DEFAULT_MODEL,
      max_tokens: 2500,
      messages: [{ role: "user", content: prompt }],
    }),
  });
  if (r.status === 429) return fail(429, "rate_limited", "Claude is busy");
  if (!r.ok) return fail(502, "unavailable", "Claude request failed (" + r.status + ")");
  const out = await r.json();
  const text = (out.content || []).filter((b) => b.type === "text").map((b) => b.text).join("");
  const a = text.indexOf("{"), b = text.lastIndexOf("}");
  try {
    return json({ design: JSON.parse(text.slice(a, b + 1)) });
  } catch {
    return fail(422, "invalid_json", "Claude's reply was not valid JSON");
  }
}

export default async (req) => {
  const parts = new URL(req.url).pathname.replace(/^\/api\/?/, "").split("/").filter(Boolean).map(decodeURIComponent);
  const [resource, key] = parts;
  const store = getStore(STORE);
  try {
    if (resource === "stands" && !key && req.method === "GET") {
      if (!isViewer(req)) return fail(401, "not_granted", "Password required");
      return json({ stands: (await readAll(store)).stands });
    }
    if (!isEditor(req)) return fail(401, "not_granted", "Editor password required");
    if (resource === "login" && req.method === "POST") return json({ ok: true });

    if (resource === "stands" && key) {
      if (!KEY_RE.test(key)) return fail(400, "invalid_argument", "Unknown stand");
      if (req.method === "DELETE") {
        await mutate(store, (s) => { delete s[key]; });
        return json({ ok: true });
      }
      if (req.method === "PUT") {
        const raw = await req.text();
        if (raw.length > 20000) return fail(413, "invalid_argument", "Stand data too large");
        let data;
        try { data = JSON.parse(raw); } catch { return fail(400, "invalid_argument", "Bad JSON"); }
        if (!data || typeof data !== "object" || Array.isArray(data)) return fail(400, "invalid_argument", "Bad stand data");
        await mutate(store, (s) => { s[key] = data; });
        return json({ ok: true });
      }
    }
    if (resource === "design" && req.method === "POST") {
      const body = await req.json().catch(() => null);
      const prompt = body && typeof body.prompt === "string" ? body.prompt : "";
      if (!prompt || prompt.length > 12000) return fail(400, "invalid_argument", "Bad prompt");
      return await design(prompt);
    }
    return fail(404, "not_found", "No such route");
  } catch (e) {
    return fail(503, "unavailable", "Storage is busy, try again");
  }
};
